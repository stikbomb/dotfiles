# .zshenv — читается на каждый запуск zsh (включая non-interactive),
# поэтому только export переменных, никакой генерации файлов на диск.

# ── PATH ──────────────────────────────────────────────────────────────────────
typeset -U path
path=("$HOME/.local/bin" $path)

# ── Editor / Browser ─────────────────────────────────────────────────────────
export EDITOR="nva"
export VISUAL="nva"
export BROWSER="vivaldi-stable"

# ── Theming ───────────────────────────────────────────────────────────────────
# GTK-тема живёт в ~/.config/gtk-3.0|gtk-4.0/settings.ini + gsettings.
# GTK_THEME здесь намеренно не выставляется — он молча перебивает их.
# Qt6 -> qt6ct; Qt5 -> QT_STYLE_OVERRIDE (одну переменную на оба не разделить).
export QT_QPA_PLATFORMTHEME="qt6ct"
export QT_STYLE_OVERRIDE="kvantum"

# ── Man pages через bat ───────────────────────────────────────────────────────
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
