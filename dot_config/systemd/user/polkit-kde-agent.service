[Unit]
Description=Polkit KDE authentication agent
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# QT_STYLE_OVERRIDE=kvantum (см. niri/cfg/misc.kdl) — это стиль QtWidgets, но
# QtQuick Controls берёт из неё имя QML-модуля, которого у Kvantum нет: диалог
# не грузится и агент падает с SIGSEGV. Она перебивает QT_QUICK_CONTROLS_STYLE,
# поэтому её нужно именно снять, а стиль QQC2 задать явно.
UnsetEnvironment=QT_STYLE_OVERRIDE
Environment=QT_QUICK_CONTROLS_STYLE=Fusion
ExecStart=/usr/lib/polkit-kde-authentication-agent-1
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
